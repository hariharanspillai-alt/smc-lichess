# SMC Lichess Tournament Creator Configuration

# Lichess API Personal Access Token
# Create one at: https://lichess.org/account/oauth/token
# Required scopes: tournament:write, team:read
LICHESS_API_TOKEN=

# SMC Academy team ID
# Find your team ID by visiting your team page on Lichess
# The team ID is in the URL: https://lichess.org/team/YOUR_TEAM_ID
LICHESS_TEAM_ID=